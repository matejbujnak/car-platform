# ---- Databáza ----
# Lokálne: postgresql://car_platform:car_platform@postgres_db:5432/car_platform
# Produkcia (Pi): napojenie na central_postgres – vyplň reálne hodnoty LEN v .env
DATABASE_URL=postgresql://user:change-me@postgres_db:5432/car_platform

# ---- Redis (fronta pre scrape/ML joby + cache) ----
REDIS_URL=redis://redis:6379/0

# ---- Backend tajomstvá ----
# Vygeneruj: openssl rand -hex 32
# V PRODE BEZ TOHTO APPKA NESPADNE, LEN AK CHÝBA -> odmietne štartovať
SECRET_KEY=

# ---- Admin účet (seeduje sa pri prvom štarte) ----
# Silné heslo! Žiadne defaulty – appka bez hesla v prode neštartuje
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- CORS / doména ----
# Napr. https://demo.tvojadomena.sk alebo http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ---- Scraper (autobazar.eu) ----
# Slušné limity – nižšie číslo = menšie riziko banu
SCRAPE_MAX_PER_HOUR=30
SCRAPE_WINDOW_START_HOUR=1
SCRAPE_WINDOW_END_HOUR=5
