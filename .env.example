# ---- Database ----
# Dedicated user/database for this app.
DATABASE_URL=postgresql://user:change-me@postgres_db:5432/car_platform

# ---- Redis (job queue + cache) ----
REDIS_URL=redis://redis:6379/0

# ---- Backend secrets ----
# Generate with: openssl rand -hex 32
SECRET_KEY=

# ---- Admin account (seeded on first start) ----
# Use a strong password. The app refuses to start in production mode
# when this is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- CORS / public origin ----
# Example: https://demo.example.com or http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# ---- Scraper rate limits ----
# Be polite to the source site; lower values reduce the risk of being blocked.
SCRAPE_MAX_PER_HOUR=30
SCRAPE_WINDOW_START_HOUR=1
SCRAPE_WINDOW_END_HOUR=5
