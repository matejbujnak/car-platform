# ---- Database ----
# PostgreSQL runs inside the production stack (service "postgres_db").
# Generate a strong password: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---- Redis (job queue + cache) ----
REDIS_URL=redis://redis:6379/0

# ---- Backend secrets ----
# Generate with: openssl rand -hex 32
# The app refuses to start in production when this is empty.
SECRET_KEY=

# ---- Environment ----
# "development" or "production". Production additionally requires SECRET_KEY
# and ADMIN_PASSWORD to be set, otherwise the app refuses to start.
APP_ENV=production

# ---- Auth ----
# Lifetime of the access token in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---- Admin account (seeded on first start) ----
# Use a strong password. The app refuses to start in production mode
# when this is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- CORS / public origin ----
# The public URL of the app, e.g. https://demo.example.com
# (not critical when the frontend proxies /api on the same origin).
ALLOWED_ORIGINS=

# ---- Docker network ----
# External network shared with the reverse proxy (create it once with
# "docker network create home_network" when it does not exist yet).
DOCKER_NETWORK=home_network

# ---- Scraper (source site) ----
# Be polite to the source site; lower values reduce the risk of being blocked.
# The hourly cap is a hard safety net - when reached, the worker pauses until
# the next hour and then continues. The daily full crawl is NOT limited by
# SCRAPE_QUICK_MAX_PAGES; it crawls the catalogue segment by segment.
SCRAPE_MAX_PER_HOUR=500
# Page limit for quick manual runs only (20 listings per page).
SCRAPE_QUICK_MAX_PAGES=5
# Random delay between requests, in seconds.
SCRAPE_MIN_DELAY_SECONDS=5
SCRAPE_MAX_DELAY_SECONDS=9

# ---- Daily scheduled crawl ----
# Hour of the day when the full-site crawl starts. It is deliberately slow and
# may run for several hours.
SCRAPE_SCHEDULE_HOUR=22
# Timezone for SCRAPE_SCHEDULE_HOUR and the scrape window hours (IANA name).
SCHEDULE_TZ=Europe/Bratislava
